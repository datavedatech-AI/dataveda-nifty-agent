# ==========================================================================
# DataVeda Nifty Agent - environment configuration
# Copy this file to .env and fill in real values. Never commit .env.
# ==========================================================================

# --- Webhook security -------------------------------------------------------
# Shared secret that must appear in every TradingView alert payload
# (as the "passphrase" field). Generate a long random string.
WEBHOOK_PASSPHRASE=change-me-to-a-long-random-string

# Optional: comma-separated list of source IPs allowed to call the webhook.
# TradingView's published alert IPs (subject to change, verify before relying
# on this alone): 52.89.214.238,34.212.75.30,54.218.53.128,52.32.178.7
# Leave empty to disable IP allowlisting (rely on passphrase only).
WEBHOOK_ALLOWED_IPS=

# --- Trading mode -------------------------------------------------------
# live  -> orders are actually sent to the broker(s)
# paper -> orders are validated and logged but NOT sent anywhere
# Defaults to "live" per explicit configuration. Set to "paper" while testing.
TRADING_MODE=live

# Master kill switch. If true, ALL incoming signals are rejected regardless
# of TRADING_MODE. Flip this on to instantly halt trading.
KILL_SWITCH=false

# --- Enabled brokers ------------------------------------------------------
# Comma-separated: dhan,mt5 (or just one of them)
ENABLED_BROKERS=dhan,mt5

# --- DHAN ------------------------------------------------------------------
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
DHAN_BASE_URL=https://api.dhan.co/v2

# --- MetaTrader 5 ------------------------------------------------------------
# Direct mode: this process runs on the same Windows host as the MT5 terminal.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_TERMINAL_PATH=

# Bridge mode: MT5 terminal runs on a separate Windows host; this agent
# (e.g. in a Linux Docker container) talks to it over HTTP. See README.
MT5_MODE=direct
MT5_BRIDGE_URL=

# --- Risk management ---------------------------------------------------------
# Hard cap on order quantity/lots per single signal, per symbol.
RISK_MAX_QTY_PER_ORDER=75
# Hard cap on number of simultaneously open positions.
RISK_MAX_OPEN_POSITIONS=5
# Daily realized-loss circuit breaker (in account currency). Once tripped,
# the kill switch effectively engages until reset the next trading day.
RISK_MAX_DAILY_LOSS=10000
# Comma-separated allowlist of symbols the agent is permitted to trade.
# Leave empty to allow any symbol present in SYMBOL_MAP.
RISK_ALLOWED_SYMBOLS=NIFTY,BANKNIFTY

# --- Symbol mapping -----------------------------------------------------
# JSON mapping from the "symbol" TradingView sends to each broker's own
# instrument identifier. See README for format and examples.
SYMBOL_MAP_FILE=symbol_map.json

# --- Storage -----------------------------------------------------------
DATABASE_URL=sqlite:///./data/trades.db

# --- App -----------------------------------------------------------
LOG_LEVEL=INFO
