# ==========================================================================
# DataVeda MT5 Bridge - server configuration
# Copy to .env. Per-tenant credentials (broker login, webhook passphrase,
# agent token) are NOT configured here - they're issued per account via
# POST /signup and stored in the database. This file is server-wide only.
# ==========================================================================

# Postgres is recommended for anything beyond local testing (SQLite works
# for dev but has weaker concurrent-write characteristics for a multi-
# tenant service). Async drivers only: postgresql+asyncpg://... or
# sqlite+aiosqlite:///./data/tenants.db
DATABASE_URL=postgresql+asyncpg://dataveda:changeme@localhost:5432/dataveda

LOG_LEVEL=INFO

# How long the webhook handler waits for a tenant's bridge agent to
# acknowledge an order over the WebSocket relay before giving up.
BRIDGE_ORDER_TIMEOUT_SECONDS=8.0

# Required for /admin/* (grant/revoke subscriptions, list tenants) and the
# /admin dashboard page to work at all - left unset, those routes fail
# closed (401) rather than allowing access. This is YOUR key, not a
# customer's - generate a long random value, e.g.: openssl rand -hex 32
ADMIN_API_KEY=

# Used by docker-compose.yml to set the Postgres container's password.
POSTGRES_PASSWORD=changeme
